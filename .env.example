# ============================================
# Environment Variables for IRAN CV Analyzer
# ============================================

# Ollama API Configuration
# Host address for the Ollama service (inside Docker network)
OLLAMA_HOST=http://ollama:11434

# Application Port
# Port on which the Shiny app will be accessible
PORT=3838

# Optional: Ollama model (default is llama3.2)
# If you want to use a different model, change this value
OLLAMA_MODEL=llama3.2
